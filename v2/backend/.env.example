# Invector v2 (path-first). Every value is optional — the app runs keyless.
# Without OPENAI_API_KEY every AI call uses its deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORT=3002
# Payments are not built. Mock unlocks default ON outside production and OFF
# in production unless MOCK_PAYMENTS=1.
# MOCK_PAYMENTS=1
