PORT=3001
# Optional: without a key every AI call uses deterministic fallbacks (demo mode).
OPENAI_API_KEY=sk-abcdef1234567890abcdef1234567890abcdef12
OPENAI_MODEL=gpt-4.1-mini

# Experimental: generate Big Five items per session via AI instead of the
# validated public-domain IPIP sets. Off by default on purpose.
AI_BIG_FIVE_ITEMS=false

# Comma-separated allowed CORS origins (Vite-proxied dev traffic bypasses CORS).
CORS_ORIGIN=http://localhost:5173

# Abuse protection (defaults: 15min window, 300 global, 30 on AI routes).
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_GLOBAL_MAX=300
#RATE_LIMIT_AI_MAX=30
