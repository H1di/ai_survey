PORT=3001
# Optional: without a key every AI call uses deterministic fallbacks (demo mode).
OPENAI_API_KEY=sk-abcdef1234567890abcdef1234567890abcdef12
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated allowed CORS origins (Vite-proxied dev traffic bypasses CORS).
CORS_ORIGIN=http://localhost:5173

# Abuse protection (defaults: 15min window, 300 global, 30 on AI routes).
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_GLOBAL_MAX=300
#RATE_LIMIT_AI_MAX=30

# Reverse-proxy hop count so rate limiting sees real client IPs behind
# Render/Vercel. Defaults to 1 when NODE_ENV=production, untrusted otherwise.
#TRUST_PROXY=1

# Optional: O*NET Web Services key (free registration at services.onetcenter.org).
# Without it, occupation data comes from the bundled snapshot (backend/data/
# onet-snapshot.json) — everything works, but US salary/outlook stay hidden.
#ONET_API_KEY=your-onet-api-key

# Optional path to the MarkItDown CLI (adds .pptx/.html + better extraction).
# Without it the app falls back to built-in pdf/docx/txt/html parsing.
# Install locally: python3 -m venv ~/.venvs/markitdown && ~/.venvs/markitdown/bin/pip install "markitdown[all]"
#MARKITDOWN_BIN=~/.venvs/markitdown/bin/markitdown

# Durable sessions (optional): set BOTH to persist sessions in Upstash Redis so
# they survive restarts / Render idle-sleep. Without them, sessions are
# in-memory only and lost on restart. Create a database at https://upstash.com
# and copy its REST URL + token.
#UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
#UPSTASH_REDIS_REST_TOKEN=your-rest-token
